# Used by the production process. Export variables in the hosting dashboard,
# or run: node --env-file=.env dist-server/index.mjs (Node.js 22+).
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
MAX_CONNECTIONS=240

# Set to the actual HTTPS URL issued by your host, with no trailing slash.
# Same-host browser requests are accepted without this variable.
# Render blueprint obtains its real URL from RENDER_EXTERNAL_URL automatically.
PUBLIC_ORIGIN=

# Optional exact additional browser origins, comma-separated; no wildcard.
# Example only: https://garden.example.com,https://www.garden.example.com
ALLOWED_ORIGINS=
